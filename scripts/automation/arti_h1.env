# scripts/automation/arti_h1.env  (arti-autotrain@arti_h1 서비스가 저장소의 이 파일을 직접 읽음)
PROJECT_DIR=/opt/isaac/workspace/project/arti_h1
CONTAINER=arti-h1
BRANCH=main
TASK=Template-Arti-H1-Amp-Direct-v0
ALGO=AMP
PHYSICS=isaacsim_physx               # Isaac Lab 3.x physics preset (isaacsim_physx | newton_mjwarp)
PY=python                            # 컨테이너 안의 Isaac Lab 3.x venv python
LOG_SUBDIR=arti_h1_amp_walk          # logs/skrl/<여기> (agent yaml의 experiment.directory)
RESULTS_DIR=/opt/isaac/results/repo/arti-training-results   # 결과 저장소 clone 위치
RESULTS_SUBDIR=arti_h1                # 결과 저장소 안의 로봇별 폴더
PUBLISH_EVERY_STEPS=300000            # 이 step 배수의 agent_N.pt만 LFS로 올림 (5000의 배수). 로컬 기준 ~49k step/h → 약 6시간에 1개 (LFS 무료 10GiB)
PUSH_INTERVAL_SEC=21600               # 결과 push 주기 (6시간)
POLL_SEC=60                           # 코드 저장소 확인 주기
