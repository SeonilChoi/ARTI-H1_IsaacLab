# /etc/systemd/system/arti-autotrain@.service   (arti_h1 / arti_d1 공용, 저장소의 이 파일을 복사)
# 사용: sudo systemctl enable --now arti-autotrain@arti_h1   (→ project/arti_h1/scripts/automation/arti_h1.env)
# 스크립트와 env는 저장소 안의 것을 직접 실행 → push로 고치면 auto_train.sh가 pull 후 스스로 다시 실행
[Unit]
Description=Isaac Lab auto-train loop (%i)
After=docker.service network-online.target
Wants=network-online.target

[Service]
User=iicuser
ExecStart=/bin/bash /opt/isaac/workspace/project/%i/scripts/automation/auto_train.sh /opt/isaac/workspace/project/%i/scripts/automation/%i.env
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
